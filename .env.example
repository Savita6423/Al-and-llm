# Frontend server-to-server connection
BACKEND_API_URL=http://127.0.0.1:8000

# NVIDIA hosted model API (server only)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# GNews (server only)
GNEWS_API_KEY=

# Supabase: browser values are publishable/anon keys protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Open-Meteo needs no API key.

